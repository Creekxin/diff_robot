<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fishbot">
    <xacro:include filename="$(find fishbot_description)/urdf/fishbot/common_inertial.xacro" />
    <xacro:macro name="laser_xacro" params="xyz">
        <!--雷达支撑杆-->
        <link name="laser_cylinder_link">
            <visual> 
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.12" />
                </geometry>  
                <material name="black">
                    <color rgba="1.0 0 0 1.0"/>
                </material>
            </visual>
            <xacro:cylinder_inertia m="0.05" r="0.01" h="0.10" />
        </link>
        
        <!--雷达-->
        <link name="laser_link">
            <visual> 
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <!-- 雷达头：半径2cm, 厚度2cm -->
                    <cylinder radius="0.02" length="0.02" />
                </geometry>  
                <material name="black">
                    <color rgba="0 0 0 1.0"/>
                </material>
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <!-- 雷达头：半径2cm, 厚度2cm -->
                    <cylinder radius="0.02" length="0.02" />
                </geometry>  
                <material name="black">
                    <material name="black">
                    <color rgba="0 1.0 0 0.8"/>
                </material>
                </material>
            </collision>
            <xacro:cylinder_inertia m="0.1" r="0.02" h="0.02" />
        </link>
        
        <!--雷达固定到雷达支撑杆-->
        <joint name="laser_joint" type="fixed">
            <parent link="laser_cylinder_link"/>
            <child link="laser_link"/>
            <!-- 修正：将雷达头放在支撑杆的顶部 -->
            <!-- 支撑杆长0.1，半长0.05。放在0.06处刚好在顶面上方一点 -->
            <origin xyz="0.0 0.0 0.06" rpy="0 0 0"/>
        </joint>

        <!--雷达支撑杆固定到base_link-->
        <joint name="laser_cylinder_joint" type="fixed">
            <parent link="base_link"/>
            <child link="laser_cylinder_link"/>
            <!-- 这里的 xyz 是支撑杆中心的位置 -->
            <origin xyz="${xyz}" rpy="0 0 0"/>
        </joint>
        <gazebo reference="laser_cylinder_link">
            <material>Gazebo/Black</material>
        </gazebo>
        <gazebo reference="laser_link">
            <material>Gazebo/Black</material>
        </gazebo>
    </xacro:macro>
</robot>