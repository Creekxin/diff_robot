<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fishbot">
    <xacro:include filename="$(find fishbot_description)/urdf/fishbot/common_inertial.xacro" />
    <xacro:macro name="camera_xacro" params="xyz">
        <link name="camera_link">
            <visual> 
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <box size="0.02 0.10 0.02"/>
                </geometry>  
                <material name="black">
                    <color rgba="0 1.0 0 0.8"/>
                </material>
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <box size="0.02 0.10 0.02"/>
                </geometry>  
                <material name="black">
                    <material name="black">
                    <color rgba="0 1.0 0 0.8"/>
                </material>
                </material>
            </collision>
            <xacro:box_inertia m="0.1" w="0.02" h="0.10" d="0.02" />
        </link>
        <link name="camera_optical_link">
            
        </link>
        <!--机器人关节的关节，用于组合,深度相机的前方是Z轴-->
        <joint name="camera_joint" type="fixed">
            <!-- 父部件--> 
            <parent link="base_link"/>
            <!-- 子部件-->
            <child link="camera_link"/>
            <!-- 子部件相对于父部件的旋转量与偏移量-->
            <origin xyz="${xyz}" rpy="0 0 0"/>
        </joint>
        <!--使得深度相机的Z朝前方-->
        <joint name="camera_optical_joint" type="fixed">
            <!-- 父部件--> 
            <parent link="camera_link"/>
            <!-- 子部件--> 
            <child link="camera_optical_link"/>
            <!-- 子部件相对于父部件的旋转量与偏移量-->
            <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
        </joint>
    </xacro:macro>
</robot>