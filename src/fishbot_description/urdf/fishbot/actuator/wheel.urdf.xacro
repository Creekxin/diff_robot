<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fishbot">
    <xacro:macro name="wheel_xacro" params="wheel_name xyz">
        <link name="${wheel_name}_wheel_link">
            <visual> 
                <origin rpy="1.57079 0 0" xyz="0 0 0"/>
                <geometry>
                    <cylinder radius="0.0325" length="0.04" />
                </geometry>  
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </visual>
            <collision>
                <origin rpy="1.57079 0 0" xyz="0 0 0"/>
                <geometry>
                    <cylinder radius="0.0325" length="0.04" />
                </geometry>  
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </collision>
            <xacro:cylinder_inertia m="0.05" r="0.0325" h="0.04"/>
        </link>
        
        <joint name="${wheel_name}_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_name}_wheel_link"/>
            <origin xyz="${xyz}"/>
            <!-- 绕旋转完成后的轴转动 -->
            <axis xyz="0 1 0"/>
        </joint>
        <gazebo reference="${wheel_name}_wheel_link">
            <!--切向摩擦系数-->
            <mu1 value="20.0"/>
            <!--法向摩擦系数-->
            <mu2 value="20.0"/>
            <!-- 接触刚度系数 -->
            <kp value="1000000000.0"/>
            <!-- 阻尼系数 -->
            <kd value="1.0"/>
        </gazebo>
    </xacro:macro>
</robot>